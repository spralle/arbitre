{
	"name": "arbitre",
	"private": true,
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "bun run --filter '*' build:dist",
		"typecheck": "bun run --filter '*' build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.27.0",
		"@vitest/coverage-v8": "^4.1.8",
		"fast-check": "^4.8.0",
		"tsup": "^8.3.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0"
	},
	"packageManager": "bun@1.2.0"
}
